---
import { render } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Giscus from "@/components/Giscus.astro";
import Icon from "@/components/Icon.astro";
import { getPublishedPosts, postSlug, tagSlug } from "@/lib/blog";
import { getRelatedProjects } from "@/lib/related";
import "@/styles/prose.css";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: postSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const related = await getRelatedProjects(post);

const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const dateFmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---
<BaseLayout
  title={`${post.data.title} | Jesús Blázquez`}
  description={post.data.description}
  type="article"
  keywords={post.data.tags}
  article={{
    publishedTime: post.data.pubDate.toISOString(),
    modifiedTime: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    tags: post.data.tags,
  }}
>
  <article class="post">
    <div class="container post-head">
      <a href="/blogs/" class="back-link"><Icon name="arrow" size={16} class="flip" /> All writing</a>
      <h1>{post.data.title}</h1>
      <p class="post-meta">
        <time datetime={post.data.pubDate.toISOString()}>
          {dateFmt.format(post.data.pubDate)}
        </time>
        {post.data.draft && <span class="draft-flag">draft</span>}
      </p>
      {
        post.data.tags.length > 0 && (
          <ul class="post-tags">
            {post.data.tags.map((t) => (
              <li>
                <a href={`/tags/${tagSlug(t)}/`} class="tag">{t}</a>
              </li>
            ))}
          </ul>
        )
      }
    </div>

    <div class="container post-body">
      {
        toc.length > 2 && (
          <aside class="toc" aria-label="Table of contents">
            <p class="toc-title">On this page</p>
            <nav>
              <ul>
                {toc.map((h) => (
                  <li class={`toc-d${h.depth}`}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )
      }

      <div class="post-content">
        <div class="prose">
          <Content />
        </div>

        {
          related.length > 0 && (
            <section class="related" aria-label="Related projects">
              <h2>Related project{related.length > 1 ? "s" : ""}</h2>
              <ul>
                {related.map((p) => (
                  <li>
                    <a href={`/projects/#${p.id}`} class="rel-title">{p.title}</a>
                    <span class="rel-blurb">{p.blurb}</span>
                  </li>
                ))}
              </ul>
            </section>
          )
        }

        <Giscus />
      </div>
    </div>
  </article>

  <button id="to-top" class="to-top" type="button" aria-label="Back to top">
    <Icon name="chevron" size={20} class="up" />
  </button>
</BaseLayout>

<script>
  const btn = document.getElementById("to-top");
  const onScroll = () => btn?.toggleAttribute("data-show", window.scrollY > 500);
  window.addEventListener("scroll", onScroll, { passive: true });
  btn?.addEventListener("click", () =>
    window.scrollTo({ top: 0, behavior: "smooth" }),
  );

  // highlight current TOC entry
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
  if (links.length) {
    const map = new Map<string, HTMLAnchorElement>();
    links.forEach((l) => map.set(l.getAttribute("href")!.slice(1), l));
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            links.forEach((l) => l.removeAttribute("data-active"));
            map.get(e.target.id)?.setAttribute("data-active", "");
          }
        });
      },
      { rootMargin: "-10% 0px -80% 0px" },
    );
    document
      .querySelectorAll(".prose h2[id], .prose h3[id]")
      .forEach((h) => io.observe(h));
  }
</script>

<style>
  .post-head {
    padding-top: 3rem;
    max-width: 48rem;
  }
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-2);
    margin-bottom: 1.5rem;
  }
  .back-link:hover { color: var(--accent); }
  .back-link :global(.flip) { transform: rotate(180deg); }
  .post-head h1 {
    font-size: clamp(1.9rem, 5vw, 3rem);
    line-height: 1.08;
  }
  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-dim);
  }
  .draft-flag {
    color: var(--warn);
    border: 1px solid var(--warn);
    border-radius: 999px;
    padding: 0 0.5rem;
    font-size: 0.72rem;
  }
  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin-top: 1.1rem;
  }
  .post-tags .tag:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .post-body {
    display: grid;
    gap: 2.5rem;
    margin-top: 2.5rem;
    align-items: start;
  }
  .post-content { min-width: 0; }
  .toc {
    display: none;
  }
  @media (min-width: 1040px) {
    .post-body {
      grid-template-columns: 1fr 15rem;
      max-width: 64rem;
    }
    .post-content { order: 1; }
    .toc {
      order: 2;
      display: block;
      position: sticky;
      top: 6rem;
      font-size: 0.85rem;
      border-left: 1px solid var(--border);
      padding-left: 1rem;
      max-height: calc(100dvh - 8rem);
      overflow-y: auto;
    }
    .toc-title {
      font-family: var(--font-mono);
      color: var(--fg-dim);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      font-size: 0.72rem;
      margin-bottom: 0.6rem;
    }
    .toc ul { list-style: none; padding: 0; margin: 0; }
    .toc li { margin: 0.15rem 0; }
    .toc-d3 { padding-left: 0.9rem; }
    .toc a {
      color: var(--fg-dim);
      display: block;
      padding: 0.2rem 0;
      line-height: 1.35;
    }
    .toc a:hover { color: var(--fg); }
    .toc a[data-active] { color: var(--accent); }
  }

  .related {
    margin-top: 3rem;
    padding: 1.5rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }
  .related h2 { font-size: 1.1rem; margin-bottom: 0.75rem; }
  .related ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.75rem; }
  .related .rel-title { display: inline-block; font-weight: 600; }
  .related .rel-blurb { display: block; color: var(--fg-2); font-size: 0.92rem; }

  .to-top {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    color: var(--fg);
    backdrop-filter: blur(8px);
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition: opacity 0.25s ease, transform 0.25s ease;
    z-index: 90;
  }
  .to-top[data-show] { opacity: 1; transform: none; pointer-events: auto; }
  .to-top:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, var(--surface));
    transform: translateY(-2px);
  }
  .to-top :global(.up) { transform: rotate(180deg); }
</style>
