---
import BaseLayout from "@/layouts/BaseLayout.astro";
---
<BaseLayout title="404 · Not found | Jesús Blázquez" description="Page not found.">
  <section class="section notfound">
    <div class="container">
      <p class="code">404</p>
      <h1 class="section-title">Segmentation fault</h1>
      <p class="msg">
        That address doesn't map to anything. The page may have moved or never
        existed.
      </p>
      <div class="actions">
        <a href="/" class="btn btn-primary">Back home</a>
        <a href="/blogs/" class="btn btn-ghost">Read the blog</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound { text-align: center; padding-block: 6rem; }
  .code {
    font-family: var(--font-mono);
    font-size: clamp(3rem, 14vw, 7rem);
    color: var(--accent);
    line-height: 1;
    letter-spacing: 0.05em;
  }
  .msg {
    color: var(--fg-2);
    max-width: 32rem;
    margin: 1rem auto 2rem;
  }
  .actions { display: flex; gap: 0.75rem; justify-content: center; flex-wrap: wrap; }
</style>
