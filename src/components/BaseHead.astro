---
// All <head> SEO. Reproduces the old Hugo setup: canonical, RSS alternate,
// favicons, OpenGraph, Twitter cards, and JSON-LD (Person on home, Article on
// posts). Pages that exist in both languages also get hreflang alternates.
import { getPortfolio } from "@/data/portfolio";
import {
  LANG_META,
  DEFAULT_LANG,
  PUBLISHED_LANGS,
  basePath,
  getLang,
  isPublished,
  isTranslated,
  localePath,
} from "@/i18n";

interface ArticleMeta {
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
}
interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  keywords?: string[];
  article?: ArticleMeta;
}

const lang = getLang(Astro.currentLocale);
const portfolio = getPortfolio(lang);

const {
  title,
  description = portfolio.meta.description,
  image = portfolio.meta.ogImage,
  type = "website",
  keywords = portfolio.meta.keywords,
  article,
} = Astro.props;

const site = Astro.site ?? new URL("https://www.jesusblazquez.eu");
const canonical = new URL(Astro.url.pathname, site);
const ogImage = new URL(image, site);
const siteName = portfolio.meta.title;

const base = basePath(Astro.url.pathname);
const isHome = base === "/";
const alternates =
  isTranslated(Astro.url.pathname) && PUBLISHED_LANGS.length > 1
    ? PUBLISHED_LANGS.map((l) => ({ lang: l, href: new URL(localePath(l, base), site).href }))
    : [];

const en = getPortfolio(DEFAULT_LANG);
const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: siteName,
  url: site.href,
  description: en.meta.description,
  jobTitle: "Computer Science & Mathematics Student",
  affiliation: {
    "@type": "CollegeOrUniversity",
    name: "Universidad Autónoma de Madrid",
  },
  homeLocation: {
    "@type": "Place",
    address: { "@type": "PostalAddress", addressCountry: "ES" },
  },
  knowsLanguage: ["es", "en"],
  knowsAbout: [
    "Systems Programming",
    "Security Research",
    "Cybersecurity",
    "C",
    "C++",
    "Mathematics",
  ],
  sameAs: [
    "https://github.com/jesuscbm",
    "https://www.linkedin.com/in/jesuscblazquez",
  ],
};

const articleLd = article
  ? {
      "@context": "https://schema.org",
      "@type": "Article",
      headline: title,
      description,
      inLanguage: "en",
      datePublished: article.publishedTime,
      dateModified: article.modifiedTime ?? article.publishedTime,
      author: { "@type": "Person", name: siteName, url: site.href },
      mainEntityOfPage: canonical.href,
    }
  : null;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />

<title>{title}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords.join(", ")} />
<meta name="author" content={portfolio.meta.author} />
<link rel="canonical" href={canonical.href} />
{!isPublished(lang) && <meta name="robots" content="noindex" />}
{
  alternates.map((a) => (
    <link rel="alternate" hreflang={a.lang} href={a.href} />
  ))
}
{
  alternates.length > 0 && (
    <link
      rel="alternate"
      hreflang="x-default"
      href={new URL(localePath(DEFAULT_LANG, base), site).href}
    />
  )
}

<!-- icons -->
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/img/favicon-32x32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/img/favicon.ico" sizes="any" />
<link rel="apple-touch-icon" sizes="180x180" href="/img/apple-touch-icon.png" />

<!-- feed -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={siteName}
  href={new URL("/index.xml", site).href}
/>

<meta name="theme-color" content="#1a1b26" media="(prefers-color-scheme: dark)" />
<meta name="theme-color" content="#f2f4f8" media="(prefers-color-scheme: light)" />
<meta name="generator" content={Astro.generator} />

<!-- OpenGraph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical.href} />
<meta property="og:site_name" content={siteName} />
<meta property="og:image" content={ogImage.href} />
<meta property="og:locale" content={LANG_META[lang].og} />
{
  alternates
    .filter((a) => a.lang !== lang)
    .map((a) => <meta property="og:locale:alternate" content={LANG_META[a.lang].og} />)
}
{
  article?.publishedTime && (
    <meta property="article:published_time" content={article.publishedTime} />
  )
}
{
  article?.tags?.map((t) => <meta property="article:tag" content={t} />)
}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.href} />

<!-- structured data -->
{isHome && (
  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
)}
{articleLd && (
  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
)}
