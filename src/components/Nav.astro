---
import Logo from "@/components/Logo.astro";
import Icon from "@/components/Icon.astro";

// On the home page the section links are in-page anchors; elsewhere they point
// back to the home page's sections.
const home = Astro.url.pathname === "/";
const base = home ? "" : "/";
const links = [
  { label: "About", href: `${base}#about` },
  { label: "Work", href: `${base}#experience` },
  { label: "Projects", href: `${base}#projects` },
  { label: "Writing", href: "/blogs/" },
  { label: "Contact", href: `${base}#contact` },
];
---
<header class="site-header" id="site-header" data-header>
  <div class="container header-inner">
    <a href="/" class="brand" aria-label="Home, Jesús Blázquez">
      <Logo size={34} class="brand-mark" />
      <span class="brand-name">Blázquez</span>
    </a>

    <nav class="nav-desktop" aria-label="Primary">
      {links.map((l) => <a href={l.href}>{l.label}</a>)}
    </nav>

    <div class="header-actions">
      <button
        id="theme-toggle"
        class="icon-btn"
        type="button"
        aria-label="Toggle color theme"
        title="Toggle theme"
      >
        <Icon name="moon" size={18} class="i-moon" />
        <Icon name="sun" size={18} class="i-sun" />
      </button>
      <button
        id="menu-toggle"
        class="icon-btn nav-mobile-toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="burger" aria-hidden="true"></span>
      </button>
    </div>
  </div>

  <nav class="nav-mobile" id="mobile-menu" aria-label="Mobile" hidden>
    {links.map((l) => <a href={l.href} class="nav-mobile-link">{l.label}</a>)}
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease, transform 0.3s ease, background 0.3s ease;
  }
  .site-header[data-scrolled] {
    border-bottom-color: var(--border);
  }
  .site-header[data-hidden] {
    transform: translateY(-100%);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 4.25rem;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--fg);
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .brand :global(.brand-mark) {
    color: var(--accent);
    transition: transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .brand:hover :global(.brand-mark) {
    transform: rotate(-8deg) scale(1.06);
  }
  .brand-name {
    font-size: 1.05rem;
  }
  .nav-desktop {
    display: none;
    gap: 1.6rem;
  }
  .nav-desktop a {
    color: var(--fg-2);
    font-size: 0.92rem;
    font-family: var(--font-mono);
    position: relative;
    padding: 0.2rem 0;
  }
  .nav-desktop a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s ease;
  }
  .nav-desktop a:hover {
    color: var(--fg);
  }
  .nav-desktop a:hover::after {
    transform: scaleX(1);
  }
  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--fg-2);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease,
      transform 0.15s ease;
  }
  .icon-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    transform: translateY(-2px);
  }
  .icon-btn:active { transform: translateY(0); }
  /* theme icon crossfade */
  #theme-toggle :global(.i-sun) { display: none; }
  :root[data-theme="light"] #theme-toggle :global(.i-moon) { display: none; }
  :root[data-theme="light"] #theme-toggle :global(.i-sun) { display: inline; }

  .burger,
  .burger::before,
  .burger::after {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
    transition: transform 0.25s ease, opacity 0.2s ease;
  }
  .burger::before,
  .burger::after {
    content: "";
    position: relative;
  }
  .burger::before { top: -5px; }
  .burger::after { top: 3px; }
  .nav-mobile-toggle[aria-expanded="true"] .burger { background: transparent; }
  .nav-mobile-toggle[aria-expanded="true"] .burger::before { transform: translateY(5px) rotate(45deg); }
  .nav-mobile-toggle[aria-expanded="true"] .burger::after { transform: translateY(-5px) rotate(-45deg); }

  .nav-mobile {
    display: flex;
    flex-direction: column;
    padding: 0.5rem var(--gutter) 1.25rem;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 96%, transparent);
  }
  .nav-mobile[hidden] { display: none; }
  .nav-mobile-link {
    padding: 0.85rem 0.25rem;
    color: var(--fg);
    font-family: var(--font-mono);
    border-bottom: 1px solid var(--border);
  }
  .nav-mobile-link:last-child { border-bottom: none; }

  @media (min-width: 820px) {
    .nav-desktop { display: flex; }
    .nav-mobile-toggle { display: none; }
    .nav-mobile { display: none !important; }
  }
</style>
