---
// Home page: only the featured projects, fully visible (no clicks needed),
// plus a link to the full list at /projects/.
import Icon from "@/components/Icon.astro";
import ProjectLinks from "@/components/ProjectLinks.astro";
import { getProjectsWithLinks } from "@/lib/related";
import { getLang, localePath } from "@/i18n";
import { getUI } from "@/i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = getUI(lang);
const all = await getProjectsWithLinks(lang);
const featured = all.filter((p) => p.featured);
---
<section id="projects" class="section">
  <div class="container">
    <div class="proj-head">
      <div data-reveal>
        <p class="eyebrow">{t.projects.eyebrow}</p>
        <h2 class="section-title">{t.projects.title}</h2>
        <p class="proj-lede">{t.projects.lede}</p>
      </div>
      <a href={localePath(lang, "/projects/")} class="all-link" data-reveal>
        {t.projects.all} ({all.length}) <Icon name="arrow" size={16} />
      </a>
    </div>

    <ul class="cards">
      {
        featured.map((p, i) => (
          <li class="pcard" data-reveal data-reveal-delay={`${i * 90}ms`}>
            <p class="pcard-top">
              <span class="pcard-idx" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
              {p.status && <span class="pcard-status">{p.status}</span>}
            </p>
            <h3 class="pcard-title">{p.title}</h3>
            <p class="pcard-blurb">{p.blurb}</p>
            <ul class="pcard-badges">
              {p.badges.map((b) => <li class="badge">{b}</li>)}
            </ul>
            <div class="pcard-links">
              <ProjectLinks project={p} />
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .proj-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem 2rem;
    flex-wrap: wrap;
  }
  .proj-lede { color: var(--fg-2); margin-top: 0.6rem; max-width: 40rem; }
  .all-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--accent);
    padding-block: 0.3rem;
  }
  .all-link :global(svg) { transition: transform 0.2s ease; }
  .all-link:hover :global(svg) { transform: translateX(3px); }

  .cards {
    list-style: none;
    padding: 0;
    margin: 2.25rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr));
    gap: 1.25rem;
  }
  .pcard {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    padding: 1.4rem 1.4rem 1.25rem;
    border: 1px solid var(--border);
    border-top: 2px solid var(--accent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--bg-2) 45%, transparent);
    transition: border-color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
  }
  .pcard:hover {
    border-color: var(--border-strong);
    border-top-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: var(--shadow);
  }
  .pcard-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
  .pcard-idx { color: var(--fg-dim); }
  .pcard-status {
    color: var(--ok);
    border: 1px solid color-mix(in srgb, var(--ok) 45%, transparent);
    border-radius: 999px;
    padding: 0.05rem 0.55rem;
  }
  .pcard-title { font-size: 1.2rem; line-height: 1.25; }
  .pcard-blurb { color: var(--fg-2); font-size: 0.97rem; }
  .pcard-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .pcard-links { margin-top: auto; padding-top: 0.35rem; }
</style>
