---
import Icon from "@/components/Icon.astro";
import { portfolio } from "@/data/portfolio";
import { getRelatedPosts, getProjectPageIds } from "@/lib/related";
import { postPath } from "@/lib/blog";

const pageIds = await getProjectPageIds();

const projects = await Promise.all(
  portfolio.projects.map(async (p) => ({
    ...p,
    hasPage: pageIds.has(p.id),
    posts: await getRelatedPosts(p.id),
  })),
);
---
<section id="projects" class="section">
  <div class="container">
    <p class="eyebrow" data-reveal>projects</p>
    <h2 class="section-title" data-reveal>Things I have built or broken</h2>
    <p class="proj-lede" data-reveal>
      A directory. Open an entry to read the log, the stack, and the writing
      behind it.
    </p>

    <div class="terminal" data-reveal>
      <div class="term-bar">
        <span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
        <span class="term-title">jesus@blazquez: ~/projects</span>
      </div>
      <div class="term-body">
        <p class="term-cmd"><span class="prompt">$</span> ls -l ~/projects</p>
        <ul class="term-list">
          {
            projects.map((p) => (
              <li>
                <details class="entry">
                  <summary>
                    <Icon name="chevron" size={13} class="chev" />
                    <span class="perm">drwxr-xr-x</span>
                    <span class="pname">
                      {p.id}/
                      {p.featured && <span class="star" title="featured">*</span>}
                    </span>
                    <span class="pstack">{p.badges.join(" · ")}</span>
                  </summary>
                  <div class="out">
                    <p class="term-cmd sub">
                      <span class="prompt">$</span> cat {p.id}/README.md
                    </p>
                    <p class="pdesc">{p.longDescription ?? p.blurb}</p>

                    {p.posts.length > 0 && (
                      <p class="rel">
                        <span class="rel-label"># related writing</span>
                        {p.posts.map((post) => (
                          <a href={postPath(post)} class="rel-link">
                            <Icon name="arrow" size={13} /> {post.data.title}
                          </a>
                        ))}
                      </p>
                    )}

                    <p class="acts">
                      {p.links.map((l) => (
                        <a href={l.url} target="_blank" rel="noopener" class="act">
                          {l.label} <Icon name="external" size={13} />
                        </a>
                      ))}
                      {p.hasPage && (
                        <a href={`/projects/${p.id}/`} class="act case">
                          ./case-study <Icon name="arrow" size={13} />
                        </a>
                      )}
                    </p>
                  </div>
                </details>
              </li>
            ))
          }
        </ul>
        <p class="term-cmd tail">
          <span class="prompt">$</span> <span class="caret" aria-hidden="true"></span>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .proj-lede { color: var(--fg-2); margin-top: 0.6rem; max-width: 40rem; }

  .terminal {
    margin-top: 2.5rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background: color-mix(in srgb, var(--bg-2) 82%, var(--bg));
    box-shadow: var(--shadow);
    font-family: var(--font-mono);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    background: color-mix(in srgb, var(--bg-3) 60%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .dots { display: inline-flex; gap: 0.4rem; }
  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--fg-dim);
    opacity: 0.55;
  }
  .dots i:nth-child(1) { background: var(--danger); }
  .dots i:nth-child(2) { background: var(--warn); }
  .dots i:nth-child(3) { background: var(--ok); }
  .term-title {
    font-size: 0.8rem;
    color: var(--fg-dim);
  }
  .term-body {
    padding: 1rem 1.1rem 1.25rem;
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .term-cmd { color: var(--fg-2); }
  .term-cmd .prompt { color: var(--ok); margin-right: 0.5rem; }
  .term-cmd.sub { color: var(--fg-dim); margin-bottom: 0.35rem; }

  .term-list { list-style: none; padding: 0; margin: 0.6rem 0; }
  .entry { border-radius: var(--radius-sm); }
  .entry > summary {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.4rem 0.5rem;
    list-style: none;
    border-radius: var(--radius-sm);
    white-space: nowrap;
    overflow: hidden;
  }
  .entry > summary::-webkit-details-marker { display: none; }
  .entry > summary:hover,
  .entry[open] > summary {
    background: color-mix(in srgb, var(--accent) 10%, transparent);
  }
  .entry :global(.chev) {
    color: var(--accent);
    flex: none;
    transition: transform 0.2s ease;
  }
  .entry[open] :global(.chev) { transform: rotate(180deg); }
  .perm { color: var(--fg-dim); flex: none; }
  .pname { color: var(--accent-2); font-weight: 600; flex: none; }
  .star { color: var(--warn); margin-left: 0.15rem; }
  .pstack {
    color: var(--accent-3);
    opacity: 0.85;
    font-size: 0.82rem;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .out {
    padding: 0.35rem 0.5rem 0.9rem 1.9rem;
    white-space: normal;
  }
  @media (prefers-reduced-motion: no-preference) {
    .entry[open] .out { animation: term-open 0.3s ease; }
  }
  @keyframes term-open {
    from { opacity: 0; transform: translateY(-5px); }
    to { opacity: 1; transform: none; }
  }
  .pdesc {
    font-family: var(--font-body);
    color: var(--fg);
    max-width: 46rem;
    margin-bottom: 0.75rem;
  }
  .rel { display: flex; flex-direction: column; gap: 0.2rem; margin-bottom: 0.75rem; }
  .rel-label { color: var(--fg-dim); font-size: 0.8rem; }
  .rel-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--accent-2);
    width: fit-content;
  }
  .rel-link:hover { color: var(--accent-3); }
  .acts { display: flex; flex-wrap: wrap; gap: 0.4rem 1.25rem; }
  .act {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--fg);
    border-bottom: 1px solid var(--border-strong);
  }
  .act:hover { color: var(--accent); border-color: var(--accent); }
  .act.case { color: var(--accent); }

  .term-cmd.tail { margin-top: 0.5rem; }
  .caret {
    display: inline-block;
    width: 9px;
    height: 1.05em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: term-blink 1.1s steps(2) infinite;
  }
  @keyframes term-blink {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret { animation: none; }
  }

  /* mobile: drop the perm column, let stack wrap under the name */
  @media (max-width: 560px) {
    .entry > summary { flex-wrap: wrap; white-space: normal; }
    .perm { display: none; }
    .pstack { flex-basis: 100%; padding-left: 1.4rem; }
  }
</style>
