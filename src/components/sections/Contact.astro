---
import { getPortfolio } from "@/data/portfolio";
import Icon from "@/components/Icon.astro";
import { getLang } from "@/i18n";
import { getUI } from "@/i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = getUI(lang);
const { contact } = getPortfolio(lang);
---
<section id="contact" class="section contact">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-main" data-reveal>
        <p class="eyebrow">{t.contact.eyebrow}</p>
        <h2 class="section-title">{t.contact.title}</h2>
        <p class="contact-intro">{contact.intro}</p>

        <a href={`mailto:${contact.email}`} class="btn btn-primary contact-cta">
          <Icon name="email" size={18} /> {contact.email}
        </a>

        <dl class="contact-meta">
          {
            contact.irc && (
              <div class="cm-row">
                <dt><Icon name="irc" size={16} /> IRC</dt>
                <dd>{contact.irc}</dd>
              </div>
            )
          }
          {
            contact.pgpFingerprint && (
              <div class="cm-row">
                <dt><Icon name="lock" size={16} /> PGP</dt>
                <dd class="pgp">
                  <code id="pgp-fp">{contact.pgpFingerprint}</code>
                  <button
                    type="button"
                    id="pgp-copy"
                    class="copy-btn"
                    data-copy={contact.pgpFingerprint}
                    data-label-done={t.contact.copied}
                    aria-label={t.contact.copyLabel}
                  >
                    {t.contact.copy}
                  </button>
                  <span id="pgp-status" class="sr-only" role="status"></span>
                  {contact.pgpKeyUrl && (
                    <a href={contact.pgpKeyUrl} class="pgp-key">{t.contact.publicKey}</a>
                  )}
                </dd>
              </div>
            )
          }
        </dl>
      </div>

      {
        contact.faq && contact.faq.length > 0 && (
          <div class="contact-faq" data-reveal data-reveal-delay="120ms">
            <h3 class="faq-label">{t.contact.faq}</h3>
            <dl>
              {contact.faq.map((item) => (
                <div class="faq-item">
                  <dt>{item.q}</dt>
                  <dd>{item.a}</dd>
                </div>
              ))}
            </dl>
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById("pgp-copy") as HTMLButtonElement | null;
  const status = document.getElementById("pgp-status");
  btn?.addEventListener("click", async () => {
    const text = btn.dataset.copy || "";
    try {
      await navigator.clipboard.writeText(text);
      const prev = btn.textContent;
      const done = btn.dataset.labelDone ?? "";
      btn.textContent = `${done} ✓`;
      btn.setAttribute("data-done", "");
      if (status) status.textContent = done;
      setTimeout(() => {
        btn.textContent = prev;
        btn.removeAttribute("data-done");
        if (status) status.textContent = "";
      }, 1600);
    } catch {
      // clipboard unavailable, select the text as a fallback
      const fp = document.getElementById("pgp-fp");
      if (fp) {
        const range = document.createRange();
        range.selectNodeContents(fp);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
    }
  });
</script>

<style>
  .contact { padding-bottom: 5rem; }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .contact-intro {
    color: var(--fg-2);
    font-size: 1.1rem;
    max-width: 34rem;
    margin-top: 0.75rem;
  }
  .contact-cta { margin-top: 1.5rem; font-family: var(--font-mono); font-size: 0.9rem; }
  .contact-meta {
    margin-top: 2rem;
    display: grid;
    gap: 1rem;
  }
  .cm-row dt {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-dim);
  }
  .cm-row dd { margin: 0.35rem 0 0; color: var(--fg); }
  .pgp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .pgp code {
    font-size: 0.82rem;
    word-break: break-all;
    color: var(--accent-3);
  }
  .copy-btn {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    min-height: 1.75rem;
    padding: 0.2rem 0.6rem;
    border-radius: 5px;
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--fg-2);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease,
      transform 0.15s ease;
  }
  .copy-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    transform: translateY(-2px);
  }
  .copy-btn:active { transform: translateY(0); }
  .copy-btn[data-done] { color: var(--ok); border-color: var(--ok); }
  .pgp-key { font-size: 0.82rem; font-family: var(--font-mono); padding-block: 0.25rem; }

  .faq-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-dim);
    margin-bottom: 0.5rem;
  }
  .faq-item {
    padding: 1rem 0;
    border-bottom: 1px solid var(--border);
  }
  .faq-item dt {
    font-weight: 600;
    font-size: 0.98rem;
  }
  .faq-item dd {
    margin: 0.35rem 0 0;
    color: var(--fg-2);
    font-size: 0.94rem;
  }

  @media (min-width: 900px) {
    .contact-grid { grid-template-columns: 1.2fr 1fr; align-items: start; }
  }
</style>
