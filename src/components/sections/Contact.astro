---
import { portfolio } from "@/data/portfolio";
import Icon from "@/components/Icon.astro";
const { contact } = portfolio;
---
<section id="contact" class="section contact">
  <div class="container">
    <div class="contact-grid">
      <div class="contact-main" data-reveal>
        <p class="eyebrow">contact</p>
        <h2 class="section-title">{contact.heading}</h2>
        <p class="contact-intro">{contact.intro}</p>

        <a href={`mailto:${contact.email}`} class="btn btn-primary contact-cta">
          <Icon name="email" size={18} /> {contact.email}
        </a>

        <dl class="contact-meta">
          {
            contact.irc && (
              <div class="cm-row">
                <dt><Icon name="irc" size={16} /> IRC</dt>
                <dd>{contact.irc}</dd>
              </div>
            )
          }
          {
            contact.pgpFingerprint && (
              <div class="cm-row">
                <dt><Icon name="lock" size={16} /> PGP</dt>
                <dd class="pgp">
                  <code id="pgp-fp">{contact.pgpFingerprint}</code>
                  <button
                    type="button"
                    id="pgp-copy"
                    class="copy-btn"
                    data-copy={contact.pgpFingerprint}
                    aria-label="Copy PGP fingerprint"
                  >
                    copy
                  </button>
                  {contact.pgpKeyUrl && (
                    <a href={contact.pgpKeyUrl} class="pgp-key">public key</a>
                  )}
                </dd>
              </div>
            )
          }
        </dl>
      </div>

      {
        contact.faq && contact.faq.length > 0 && (
          <div class="contact-faq" data-reveal data-reveal-delay="120ms">
            <p class="faq-label">Good to know</p>
            {contact.faq.map((item, i) => (
              <details class="faq-item" open={i === 0}>
                <summary>
                  {item.q}
                  <Icon name="chevron" size={16} class="faq-chevron" />
                </summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        )
      }
    </div>
  </div>
</section>

<script>
  const btn = document.getElementById("pgp-copy") as HTMLButtonElement | null;
  btn?.addEventListener("click", async () => {
    const text = btn.dataset.copy || "";
    try {
      await navigator.clipboard.writeText(text);
      const prev = btn.textContent;
      btn.textContent = "copied ✓";
      btn.setAttribute("data-done", "");
      setTimeout(() => {
        btn.textContent = prev;
        btn.removeAttribute("data-done");
      }, 1600);
    } catch {
      // clipboard unavailable, select the text as a fallback
      const fp = document.getElementById("pgp-fp");
      if (fp) {
        const range = document.createRange();
        range.selectNodeContents(fp);
        const sel = window.getSelection();
        sel?.removeAllRanges();
        sel?.addRange(range);
      }
    }
  });
</script>

<style>
  .contact { padding-bottom: 5rem; }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .contact-intro {
    color: var(--fg-2);
    font-size: 1.1rem;
    max-width: 34rem;
    margin-top: 0.75rem;
  }
  .contact-cta { margin-top: 1.5rem; font-family: var(--font-mono); font-size: 0.9rem; }
  .contact-meta {
    margin-top: 2rem;
    display: grid;
    gap: 1rem;
  }
  .cm-row dt {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--fg-dim);
  }
  .cm-row dd { margin: 0.35rem 0 0; color: var(--fg); }
  .pgp {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
  }
  .pgp code {
    font-size: 0.82rem;
    word-break: break-all;
    color: var(--accent-3);
  }
  .copy-btn {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.2rem 0.55rem;
    border-radius: 5px;
    border: 1px solid var(--border-strong);
    background: transparent;
    color: var(--fg-2);
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease,
      transform 0.15s ease;
  }
  .copy-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 12%, transparent);
    transform: translateY(-2px);
  }
  .copy-btn:active { transform: translateY(0); }
  .copy-btn[data-done] { color: var(--ok); border-color: var(--ok); }
  .pgp-key { font-size: 0.8rem; font-family: var(--font-mono); }

  .faq-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-dim);
    margin-bottom: 1rem;
  }
  .faq-item {
    padding: 0;
    margin-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }
  .faq-item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.15rem;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.98rem;
  }
  .faq-item summary::-webkit-details-marker { display: none; }
  .faq-item :global(.faq-chevron) { transition: transform 0.25s ease; flex: none; }
  .faq-item[open] :global(.faq-chevron) { transform: rotate(180deg); }
  .faq-item p {
    padding: 0 1.15rem 1.15rem;
    color: var(--fg-2);
    font-size: 0.94rem;
  }

  @media (min-width: 900px) {
    .contact-grid { grid-template-columns: 1.2fr 1fr; align-items: start; }
  }
</style>
