---
import { getPortfolio } from "@/data/portfolio";
import { getLang } from "@/i18n";
import { getUI } from "@/i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = getUI(lang);
const { experience } = getPortfolio(lang);
---
<section id="experience" class="section">
  <div class="container">
    <p class="eyebrow" data-reveal>{t.experience.eyebrow}</p>
    <h2 class="section-title" data-reveal>{t.experience.title}</h2>

    <ol class="timeline">
      {
        experience.map((exp, ei) =>
          exp.jobs.map((job) => (
            <li class="tl-item" data-reveal data-reveal-delay={`${ei * 80}ms`}>
              <span class="tl-marker" aria-hidden="true" />
              <article class="tl-card">
                <div class="tl-head">
                  <div>
                    <h3 class="tl-role">{job.role}</h3>
                    <p class="tl-company">
                      {exp.companyUrl ? (
                        <a href={exp.companyUrl} target="_blank" rel="noopener">
                          {exp.company}
                        </a>
                      ) : (
                        exp.company
                      )}
                      {exp.location && <span class="tl-loc"> · {exp.location}</span>}
                    </p>
                  </div>
                  <span class="tl-date">{job.date}</span>
                </div>
                <p class="tl-summary">{job.summary}</p>
                {job.details && job.details.length > 0 && (
                  <ul class="tl-details">
                    {job.details.map((d) => <li>{d}</li>)}
                  </ul>
                )}
              </article>
            </li>
          )),
        )
      }
    </ol>
  </div>
</section>

<style>
  .timeline {
    list-style: none;
    padding: 0;
    margin: 2.5rem 0 0;
    position: relative;
  }
  .timeline::before {
    content: "";
    position: absolute;
    left: 6px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: linear-gradient(var(--border-strong), transparent);
  }
  .tl-item {
    position: relative;
    padding-left: 2.25rem;
    margin-bottom: 1.25rem;
  }
  .tl-marker {
    position: absolute;
    left: 0;
    top: 1.4rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 12%, transparent);
  }
  .tl-card {
    padding: 1.25rem 1.35rem 1.35rem;
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--bg-2) 35%, transparent);
  }
  .tl-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    align-items: baseline;
  }
  .tl-role { font-size: 1.15rem; }
  .tl-company { color: var(--fg-2); font-size: 0.95rem; margin-top: 0.15rem; }
  .tl-company a { color: var(--accent-2); }
  .tl-loc { color: var(--fg-dim); }
  .tl-date {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-dim);
    white-space: nowrap;
  }
  .tl-summary { color: var(--fg); margin-top: 0.75rem; }
  .tl-details {
    padding: 0 0 0 1.25rem;
    margin: 0.75rem 0 0;
    display: grid;
    gap: 0.5rem;
    color: var(--fg-2);
    font-size: 0.95rem;
  }
  .tl-details li::marker { color: var(--accent); }
</style>
