---
import { getPortfolio } from "@/data/portfolio";
import Icon from "@/components/Icon.astro";
import Glider from "@/components/Glider.astro";
import { getLang } from "@/i18n";
import { getUI } from "@/i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = getUI(lang);
const { hero, socials } = getPortfolio(lang);
---
<section id="hero" class="hero" aria-label={t.hero.label}>
  <canvas id="hero-canvas" class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-spotlight" aria-hidden="true"></div>
  <div class="hero-veil" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-content">
      <p class="eyebrow hero-intro">{t.hero.intro}</p>

      <h1 class="hero-name">
        {hero.name.split(" ").map((word, i) => <>{i > 0 && " "}<span class="word">{word}</span></>)}
      </h1>

      <p class="hero-role">
        <span class="role-prefix" aria-hidden="true">~$</span>
        <span>{hero.role}</span>
        <span class="role-cursor" aria-hidden="true"></span>
      </p>

      <p class="hero-location">
        <Icon name="pin" size={16} />
        {t.hero.location}
      </p>

      <p class="hero-tagline">{hero.tagline}</p>

      <div class="hero-actions">
        <a href={hero.cvUrl} class="btn btn-primary" target="_blank" rel="noopener" hreflang="en">
          {t.hero.cv}
        </a>
        <a href="#projects" class="btn btn-ghost">{t.hero.work}</a>
      </div>

      <ul class="hero-socials" aria-label={t.hero.socials}>
        {
          socials.map((s) => (
            <li>
              <a href={s.url} aria-label={s.label} target={s.url.startsWith("http") ? "_blank" : undefined} rel="noopener">
                <Icon name={s.icon} size={20} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-mark" aria-hidden="true">
      <Glider size={210} class="hero-logo" />
    </div>
  </div>

  <button
    type="button"
    id="motion-toggle"
    class="motion-toggle"
    aria-pressed="false"
    data-label-pause={t.hero.pause}
    data-label-play={t.hero.play}
    hidden
  >
    <Icon name="pause" size={14} class="i-pause" />
    <Icon name="play" size={14} class="i-play" />
    <span class="motion-label">{t.hero.pause}</span>
  </button>

  <a href="#about" class="hero-scroll" aria-label={t.hero.scroll}>
    <span class="scroll-dot"></span>
  </a>
</section>

<script>
  // ---------- Pause / play for the hero's continuous animations ----------
  // WCAG 2.2.2: anything that moves for more than 5 s needs a way to stop it.
  // State lives on <html data-motion="paused"> (restored pre-paint from
  // localStorage); the canvas and glider listen for "motionchange".
  (() => {
    const btn = document.getElementById("motion-toggle") as HTMLButtonElement | null;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    if (!btn || reduce) return; // nothing moves under reduced motion
    const root = document.documentElement;
    const label = btn.querySelector(".motion-label");
    const sync = () => {
      const paused = root.dataset.motion === "paused";
      btn.setAttribute("aria-pressed", String(paused));
      if (label)
        label.textContent = (paused ? btn.dataset.labelPlay : btn.dataset.labelPause) ?? "";
    };
    btn.hidden = false;
    sync();
    btn.addEventListener("click", () => {
      const paused = root.dataset.motion !== "paused";
      if (paused) root.dataset.motion = "paused";
      else delete root.dataset.motion;
      try {
        localStorage.setItem("pref-motion", paused ? "paused" : "running");
      } catch {}
      sync();
      document.dispatchEvent(new Event("motionchange"));
    });
  })();

  // ---------- Network field (Canvas 2D, lean) ----------
  (() => {
    const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;

    const root = document.documentElement;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const paused = () => reduce || root.dataset.motion === "paused";
    const section = canvas.closest(".hero") as HTMLElement;

    let w = 0,
      h = 0,
      dpr = 1;
    type Node = { x: number; y: number; vx: number; vy: number };
    let nodes: Node[] = [];
    let raf = 0;
    let running = false;
    let inView = true;
    const mouse = { x: -999, y: -999, active: false };

    const accent = () =>
      getComputedStyle(root).getPropertyValue("--accent-2").trim() || "#7aa2f7";

    const count = () => {
      // scale node count to area, capped for mobile perf
      const area = w * h;
      return Math.min(72, Math.max(26, Math.round(area / 22000)));
    };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = section.clientWidth;
      h = section.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + "px";
      canvas.style.height = h + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = count();
      nodes = Array.from({ length: n }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.28,
        vy: (Math.random() - 0.5) * 0.28,
      }));
    };

    const draw = (step = true) => {
      ctx.clearRect(0, 0, w, h);
      const col = accent();
      const linkDist = Math.min(w, h) < 640 ? 110 : 150;
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        if (step) {
          a.x += a.vx;
          a.y += a.vy;
          if (a.x < 0 || a.x > w) a.vx *= -1;
          if (a.y < 0 || a.y > h) a.vy *= -1;
        }
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const dx = a.x - b.x,
            dy = a.y - b.y;
          const d = Math.hypot(dx, dy);
          if (d < linkDist) {
            ctx.globalAlpha = (1 - d / linkDist) * 0.5;
            ctx.strokeStyle = col;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
      }
      // links + nodes react to the cursor
      if (mouse.active && step) {
        const reach = 190;
        const cyan =
          getComputedStyle(root).getPropertyValue("--accent-3").trim() || "#7dcfff";
        for (const p of nodes) {
          const dx = p.x - mouse.x,
            dy = p.y - mouse.y;
          const d = Math.hypot(dx, dy);
          if (d < reach) {
            // gentle attraction
            p.vx -= (dx / d) * 0.008;
            p.vy -= (dy / d) * 0.008;
            ctx.globalAlpha = (1 - d / reach) * 0.7;
            ctx.strokeStyle = cyan;
            ctx.beginPath();
            ctx.moveTo(mouse.x, mouse.y);
            ctx.lineTo(p.x, p.y);
            ctx.stroke();
          }
        }
      }
      // keep velocities bounded so attraction doesn't run away
      for (const p of nodes) {
        p.vx = Math.max(-0.6, Math.min(0.6, p.vx));
        p.vy = Math.max(-0.6, Math.min(0.6, p.vy));
      }
      ctx.globalAlpha = 0.9;
      ctx.fillStyle = col;
      for (const p of nodes) {
        ctx.beginPath();
        ctx.arc(p.x, p.y, 1.6, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    const loop = () => {
      draw();
      raf = requestAnimationFrame(loop);
    };
    const start = () => {
      if (running || paused() || !inView || document.hidden) return;
      running = true;
      loop();
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    resize();
    if (paused()) draw(false); // one static frame
    else start();

    document.addEventListener("motionchange", () => {
      if (paused()) {
        stop();
        mouse.active = false;
        section.classList.remove("has-pointer");
        draw(false);
      } else start();
    });

    // pointer reactivity (fine pointers only)
    if (!reduce && window.matchMedia("(pointer: fine)").matches) {
      section.addEventListener("pointermove", (e) => {
        if (paused()) return;
        const r = section.getBoundingClientRect();
        mouse.x = e.clientX - r.left;
        mouse.y = e.clientY - r.top;
        mouse.active = true;
        section.style.setProperty("--mx", mouse.x + "px");
        section.style.setProperty("--my", mouse.y + "px");
        section.classList.add("has-pointer");
      });
      section.addEventListener("pointerleave", () => {
        mouse.active = false;
        section.classList.remove("has-pointer");
      });
    }

    let rt: number;
    window.addEventListener("resize", () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        resize();
        if (paused()) draw(false);
      }, 150);
    });
    // pause when hero scrolled out of view / tab hidden
    if ("IntersectionObserver" in window) {
      new IntersectionObserver(
        ([e]) => {
          inView = e.isIntersecting;
          if (inView) start();
          else stop();
        },
        { threshold: 0 },
      ).observe(section);
    }
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else start();
    });
  })();
</script>

<style>
  .hero {
    position: relative;
    min-height: min(92vh, 820px);
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: 4rem;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.6;
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(60% 60% at 80% 20%, var(--accent-glow), transparent 60%),
      linear-gradient(to bottom, transparent 55%, var(--bg));
  }
  .hero-spotlight {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    background: radial-gradient(
      220px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--accent-3) 22%, transparent),
      transparent 70%
    );
  }
  .hero.has-pointer .hero-spotlight { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .hero-spotlight { display: none; }
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    width: 100%;
  }
  .hero-content { max-width: 40rem; }
  .hero-intro { font-size: 0.95rem; }
  .hero-name {
    font-size: clamp(2.6rem, 9vw, 5.5rem);
    font-weight: 800;
    line-height: 0.98;
    margin: 0.4rem 0 0.6rem;
    letter-spacing: -0.04em;
  }
  .hero-name .word {
    display: inline-block;
  }
  .hero-name .word:last-child {
    background: linear-gradient(120deg, var(--accent), var(--accent-3));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  /* gradient text disappears in Windows high-contrast mode */
  @media (forced-colors: active) {
    .hero-name .word:last-child {
      background: none;
      color: CanvasText;
    }
  }
  .hero-role {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 3.2vw, 1.3rem);
    line-height: 1.45;
    color: var(--fg);
  }
  .role-prefix { color: var(--ok); }
  .role-cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: var(--accent);
    /* blinks a few times on load, then stays (WCAG 2.2.2) */
    animation: blink 1.1s steps(2) 4;
  }
  @keyframes blink {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .role-cursor { animation: none; }
  }
  .hero-location {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.7rem;
    color: var(--fg-2);
    font-size: 0.98rem;
  }
  .hero-location :global(svg) { color: var(--accent); }
  .hero-tagline {
    color: var(--fg-2);
    font-size: 1.1rem;
    max-width: 34rem;
    margin-top: 1.1rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .hero-socials {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
  }
  .hero-socials a {
    display: inline-flex;
    padding: 0.55rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    color: var(--fg-2);
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .hero-socials a:hover {
    color: var(--accent);
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .hero-mark {
    display: none;
    justify-self: center;
    color: var(--accent);
    filter: drop-shadow(0 0 40px var(--accent-glow));
  }
  .motion-toggle {
    position: absolute;
    right: var(--gutter);
    bottom: 1.5rem;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2rem;
    padding: 0.25rem 0.65rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--surface);
    color: var(--fg-2);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .motion-toggle[hidden] { display: none; }
  .motion-toggle:hover { color: var(--accent); border-color: var(--accent); }
  .motion-toggle :global(.i-play) { display: none; }
  .motion-toggle[aria-pressed="true"] :global(.i-play) { display: inline; }
  .motion-toggle[aria-pressed="true"] :global(.i-pause) { display: none; }
  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    z-index: 2;
    width: 24px;
    height: 38px;
    border: 2px solid var(--border-strong);
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }
  .scroll-dot {
    width: 4px;
    height: 8px;
    border-radius: 2px;
    background: var(--accent);
    animation: scrolldot 1.6s ease-in-out 3;
  }
  @keyframes scrolldot {
    0% { transform: translateY(0); opacity: 1; }
    70% { transform: translateY(12px); opacity: 0; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-dot { animation: none; }
  }
  @media (min-width: 900px) {
    .hero-inner { grid-template-columns: 1.3fr 0.9fr; }
    .hero-mark { display: block; }
  }
</style>
