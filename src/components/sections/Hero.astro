---
import { portfolio } from "@/data/portfolio";
import Icon from "@/components/Icon.astro";
import Glider from "@/components/Glider.astro";
const { hero, socials } = portfolio;
---
<section id="hero" class="hero" aria-label="Introduction">
  <canvas id="hero-canvas" class="hero-canvas" aria-hidden="true"></canvas>
  <div class="hero-spotlight" aria-hidden="true"></div>
  <div class="hero-veil" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-content">
      <p class="eyebrow hero-intro">{hero.intro}</p>

      <h1 class="hero-name">
        {hero.name.split(" ").map((word) => <span class="word">{word}</span>)}
      </h1>

      <p class="hero-role" aria-live="polite">
        <span class="role-prefix">~$</span>
        <span
          id="role-text"
          data-roles={JSON.stringify(hero.roles)}
        >{hero.roles[0]}</span>
        <span class="role-cursor" aria-hidden="true"></span>
      </p>

      <p class="hero-tagline">{hero.tagline}</p>

      <div class="hero-actions">
        <a href={hero.cta.url} class="btn btn-primary" target="_blank" rel="noopener">
          {hero.cta.label}
        </a>
        <a href="#projects" class="btn btn-ghost">View work</a>
      </div>

      <ul class="hero-socials" aria-label="Social links">
        {
          socials.map((s) => (
            <li>
              <a href={s.url} aria-label={s.label} target={s.url.startsWith("http") ? "_blank" : undefined} rel="noopener">
                <Icon name={s.icon} size={20} />
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="hero-mark" aria-hidden="true">
      <Glider size={210} class="hero-logo" />
    </div>
  </div>

  <a href="#about" class="hero-scroll" aria-label="Scroll to content">
    <span class="scroll-dot"></span>
  </a>
</section>

<script>
  // ---------- Role rotator (progressive; static first role without JS) ----------
  (() => {
    const el = document.getElementById("role-text");
    if (!el) return;
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let roles: string[] = [];
    try {
      roles = JSON.parse(el.dataset.roles || "[]");
    } catch {}
    if (reduce || roles.length < 2) return;

    let ri = 0;
    let ci = roles[0].length;
    let deleting = true;
    const tick = () => {
      if (deleting) {
        ci--;
        if (ci <= 0) {
          deleting = false;
          ri = (ri + 1) % roles.length;
        }
      } else {
        ci++;
        if (ci >= roles[ri].length) {
          deleting = true;
          el.textContent = roles[ri];
          setTimeout(tick, 2200);
          return;
        }
      }
      el.textContent = roles[ri].slice(0, ci);
      setTimeout(tick, deleting ? 45 : 75);
    };
    setTimeout(tick, 2200);
  })();

  // ---------- Network field (Canvas 2D, lean) ----------
  (() => {
    const canvas = document.getElementById("hero-canvas") as HTMLCanvasElement | null;
    if (!canvas) return;
    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const section = canvas.closest(".hero") as HTMLElement;

    let w = 0,
      h = 0,
      dpr = 1;
    type Node = { x: number; y: number; vx: number; vy: number };
    let nodes: Node[] = [];
    let raf = 0;
    let running = false;
    const mouse = { x: -999, y: -999, active: false };

    const accent = () =>
      getComputedStyle(document.documentElement)
        .getPropertyValue("--accent-2")
        .trim() || "#7aa2f7";

    const count = () => {
      // scale node count to area, capped for mobile perf
      const area = w * h;
      return Math.min(72, Math.max(26, Math.round(area / 22000)));
    };

    const resize = () => {
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = section.clientWidth;
      h = section.clientHeight;
      canvas.width = w * dpr;
      canvas.height = h * dpr;
      canvas.style.width = w + "px";
      canvas.style.height = h + "px";
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = count();
      nodes = Array.from({ length: n }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.28,
        vy: (Math.random() - 0.5) * 0.28,
      }));
    };

    const draw = () => {
      ctx.clearRect(0, 0, w, h);
      const col = accent();
      const linkDist = Math.min(w, h) < 640 ? 110 : 150;
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        a.x += a.vx;
        a.y += a.vy;
        if (a.x < 0 || a.x > w) a.vx *= -1;
        if (a.y < 0 || a.y > h) a.vy *= -1;
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const dx = a.x - b.x,
            dy = a.y - b.y;
          const d = Math.hypot(dx, dy);
          if (d < linkDist) {
            ctx.globalAlpha = (1 - d / linkDist) * 0.5;
            ctx.strokeStyle = col;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(a.x, a.y);
            ctx.lineTo(b.x, b.y);
            ctx.stroke();
          }
        }
      }
      // links + nodes react to the cursor
      if (mouse.active) {
        const reach = 190;
        const cyan =
          getComputedStyle(document.documentElement)
            .getPropertyValue("--accent-3")
            .trim() || "#7dcfff";
        for (const p of nodes) {
          const dx = p.x - mouse.x,
            dy = p.y - mouse.y;
          const d = Math.hypot(dx, dy);
          if (d < reach) {
            // gentle attraction
            p.vx -= (dx / d) * 0.008;
            p.vy -= (dy / d) * 0.008;
            ctx.globalAlpha = (1 - d / reach) * 0.7;
            ctx.strokeStyle = cyan;
            ctx.beginPath();
            ctx.moveTo(mouse.x, mouse.y);
            ctx.lineTo(p.x, p.y);
            ctx.stroke();
          }
        }
      }
      // keep velocities bounded so attraction doesn't run away
      for (const p of nodes) {
        p.vx = Math.max(-0.6, Math.min(0.6, p.vx));
        p.vy = Math.max(-0.6, Math.min(0.6, p.vy));
      }
      ctx.globalAlpha = 0.9;
      ctx.fillStyle = col;
      for (const p of nodes) {
        ctx.beginPath();
        ctx.arc(p.x, p.y, 1.6, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;
    };

    const loop = () => {
      draw();
      raf = requestAnimationFrame(loop);
    };
    const start = () => {
      if (running || reduce) return;
      running = true;
      loop();
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    resize();
    if (reduce) {
      draw(); // one static frame
    } else {
      start();
      // pointer reactivity (fine pointers only)
      if (window.matchMedia("(pointer: fine)").matches) {
        section.addEventListener("pointermove", (e) => {
          const r = section.getBoundingClientRect();
          mouse.x = e.clientX - r.left;
          mouse.y = e.clientY - r.top;
          mouse.active = true;
          section.style.setProperty("--mx", mouse.x + "px");
          section.style.setProperty("--my", mouse.y + "px");
          section.classList.add("has-pointer");
        });
        section.addEventListener("pointerleave", () => {
          mouse.active = false;
          section.classList.remove("has-pointer");
        });
      }
    }

    let rt: number;
    window.addEventListener("resize", () => {
      clearTimeout(rt);
      rt = window.setTimeout(() => {
        resize();
        if (reduce) draw();
      }, 150);
    });
    // pause when hero scrolled out of view / tab hidden
    if ("IntersectionObserver" in window && !reduce) {
      new IntersectionObserver(
        ([e]) => (e.isIntersecting ? start() : stop()),
        { threshold: 0 },
      ).observe(section);
    }
    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else if (!reduce) start();
    });
  })();
</script>

<style>
  .hero {
    position: relative;
    min-height: min(92vh, 820px);
    display: flex;
    align-items: center;
    overflow: hidden;
    padding-block: 4rem;
  }
  .hero-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    opacity: 0.6;
  }
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(60% 60% at 80% 20%, var(--accent-glow), transparent 60%),
      linear-gradient(to bottom, transparent 55%, var(--bg));
  }
  .hero-spotlight {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
    background: radial-gradient(
      220px circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--accent-3) 22%, transparent),
      transparent 70%
    );
  }
  .hero.has-pointer .hero-spotlight { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .hero-spotlight { display: none; }
  }
  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: center;
    width: 100%;
  }
  .hero-content { max-width: 40rem; }
  .hero-intro { font-size: 0.95rem; }
  .hero-name {
    font-size: clamp(2.6rem, 9vw, 5.5rem);
    line-height: 0.98;
    margin: 0.4rem 0 0.5rem;
    letter-spacing: -0.03em;
  }
  .hero-name .word {
    display: inline-block;
    margin-right: 0.25em;
  }
  .hero-name .word:last-child {
    background: linear-gradient(120deg, var(--accent), var(--accent-3));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-role {
    font-family: var(--font-mono);
    font-size: clamp(1rem, 3.5vw, 1.4rem);
    color: var(--fg-2);
    display: flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 1.6em;
  }
  .role-prefix { color: var(--ok); }
  .role-cursor {
    display: inline-block;
    width: 0.6em;
    height: 1.1em;
    background: var(--accent);
    animation: blink 1.1s steps(2) infinite;
  }
  @keyframes blink {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .role-cursor { animation: none; }
  }
  .hero-tagline {
    color: var(--fg-2);
    font-size: 1.1rem;
    max-width: 34rem;
    margin-top: 1.25rem;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .hero-socials {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 1.75rem 0 0;
  }
  .hero-socials a {
    display: inline-flex;
    padding: 0.55rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--border);
    color: var(--fg-2);
    transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .hero-socials a:hover {
    color: var(--accent);
    border-color: var(--border-strong);
    transform: translateY(-2px);
  }
  .hero-mark {
    display: none;
    justify-self: center;
    color: var(--accent);
    filter: drop-shadow(0 0 40px var(--accent-glow));
  }
  .hero-scroll {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    z-index: 2;
    width: 24px;
    height: 38px;
    border: 2px solid var(--border-strong);
    border-radius: 12px;
    display: flex;
    justify-content: center;
    padding-top: 6px;
  }
  .scroll-dot {
    width: 4px;
    height: 8px;
    border-radius: 2px;
    background: var(--accent);
    animation: scrolldot 1.6s ease-in-out infinite;
  }
  @keyframes scrolldot {
    0% { transform: translateY(0); opacity: 1; }
    70% { transform: translateY(12px); opacity: 0; }
    100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-dot { animation: none; }
  }
  @media (min-width: 900px) {
    .hero-inner { grid-template-columns: 1.3fr 0.9fr; }
    .hero-mark { display: block; }
  }
</style>
