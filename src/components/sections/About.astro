---
import { getPortfolio } from "@/data/portfolio";
import Logo from "@/components/Logo.astro";
import { getLang } from "@/i18n";
import { getUI } from "@/i18n/ui";
import { rich } from "@/lib/rich";

const lang = getLang(Astro.currentLocale);
const t = getUI(lang);
const { about, skills } = getPortfolio(lang);

// neofetch-style rows: a few facts, then the skill groups.
const rows: { k: string; v: string }[] = [
  ...about.facts.map((f) => ({ k: f.key, v: f.value })),
  ...skills.map((g) => ({ k: g.name, v: g.items.join(", ") })),
];
const kw = Math.max(...rows.map((r) => r.k.length));
---
<section id="about" class="section about">
  <div class="container about-grid">
    <div class="about-text" data-reveal>
      <p class="eyebrow">{t.about.eyebrow}</p>
      <h2 class="section-title">{t.about.title}</h2>
      <p class="lead" set:html={rich(about.intro)} />

      <h3 class="hl-title">{t.about.highlights}</h3>
      <ul class="highlights">
        {about.highlights.map((h) => <li set:html={rich(h)} />)}
      </ul>

      {
        about.now && (
          <p class="now">
            <span class="now-dot" aria-hidden="true" />
            <span set:html={rich(about.now)} />
          </p>
        )
      }
    </div>

    <aside class="fetch" data-reveal data-reveal-delay="120ms" aria-label={t.about.fetch}>
      <div class="fetch-art" aria-hidden="true">
        <Logo size={104} class="fetch-logo" title="" />
      </div>
      <div class="fetch-info">
        <p class="fetch-head" aria-hidden="true">
          <span class="user">jesus</span><span class="at">@</span><span class="host">blazquez</span>
        </p>
        <p class="fetch-rule" aria-hidden="true">{"-".repeat(18)}</p>
        <dl>
          {
            rows.map((r) => (
              <div class="frow">
                <dt>{r.k.padEnd(kw, " ")}</dt>
                <dd>{r.v}</dd>
              </div>
            ))
          }
        </dl>
        <p class="fetch-palette" aria-hidden="true">
          <span style="background:var(--danger)" /><span style="background:var(--warn)" /><span style="background:var(--ok)" /><span style="background:var(--accent-3)" /><span style="background:var(--accent-2)" /><span style="background:var(--accent)" />
        </p>
      </div>
    </aside>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .lead {
    color: var(--fg-2);
    margin-top: 1rem;
    font-size: 1.1rem;
    max-width: 40rem;
  }

  /* marker-pen highlights on the key phrases, so the section can be skimmed */
  .about-text :global(strong) {
    color: var(--fg);
    font-weight: 600;
    background: linear-gradient(
      transparent 58%,
      color-mix(in srgb, var(--accent) 30%, transparent) 58%
    );
    padding-inline: 0.08em;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .hl-title {
    margin-top: 1.9rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }
  .highlights {
    list-style: none;
    padding: 0;
    margin: 0.8rem 0 0;
    display: grid;
    gap: 0.85rem;
    max-width: 42rem;
  }
  .highlights li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--fg-2);
    font-size: 1.02rem;
    line-height: 1.6;
  }
  .highlights li::before {
    content: "▸";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .now {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 1.75rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--ok);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--ok) 7%, transparent);
    font-family: var(--font-mono);
    font-size: 0.88rem;
    color: var(--fg);
    max-width: 42rem;
  }
  .now-dot {
    flex: none;
    width: 9px;
    height: 9px;
    margin-top: 0.4rem;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 60%, transparent);
    animation: pulse 2.4s ease-out 2;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 55%, transparent); }
    70% { box-shadow: 0 0 0 8px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  @media (prefers-reduced-motion: reduce) {
    .now-dot { animation: none; }
  }

  /* neofetch-style panel: logo banner on top, info wraps underneath */
  .fetch {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.5rem 1.5rem 1.35rem;
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--bg-2) 55%, transparent);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    overflow-x: auto;
  }
  .fetch-art {
    flex: none;
    align-self: center;
    color: var(--accent);
  }
  .fetch-art :global(.fetch-logo) {
    filter: drop-shadow(0 0 18px var(--accent-glow));
  }
  .fetch-info { min-width: 0; }
  .fetch-head { font-size: 0.9rem; }
  .fetch-head .user { color: var(--accent-2); font-weight: 700; }
  .fetch-head .at { color: var(--fg-dim); }
  .fetch-head .host { color: var(--accent); font-weight: 700; }
  .fetch-rule { color: var(--fg-dim); margin: 0.1rem 0 0.5rem; letter-spacing: 0.1em; }
  .fetch dl { margin: 0; display: grid; gap: 0.28rem; }
  .frow { display: flex; gap: 0.75rem; }
  .frow dt {
    color: var(--accent);
    white-space: pre;
    flex: none;
  }
  .frow dd { color: var(--fg-2); margin: 0; }
  .fetch-palette { display: flex; gap: 4px; margin-top: 0.8rem; }
  .fetch-palette span {
    width: 16px;
    height: 10px;
    border-radius: 2px;
    display: inline-block;
  }

  @media (min-width: 640px) {
    .fetch { font-size: 0.86rem; }
  }
  @media (min-width: 900px) {
    .about-grid { grid-template-columns: 1.35fr 1fr; align-items: start; }
    .fetch { position: sticky; top: 6rem; }
  }
</style>
