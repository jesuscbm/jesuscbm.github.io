---
import { portfolio } from "@/data/portfolio";
import Logo from "@/components/Logo.astro";
const { about, skills } = portfolio;

// neofetch-style rows built from the skills data + a couple of static facts.
const rows: { k: string; v: string }[] = [
  { k: "host", v: "UAM · CS + Mathematics" },
  { k: "focus", v: "low-level systems, security, maths" },
  ...skills.map((g) => ({ k: g.name.toLowerCase(), v: g.items.join(", ") })),
];
const kw = Math.max(...rows.map((r) => r.k.length));
---
<section id="about" class="section about">
  <div class="container about-grid">
    <div class="about-text" data-reveal>
      <p class="eyebrow">about</p>
      <h2 class="section-title">{about.heading}</h2>
      {about.paragraphs.map((p) => <p class="para">{p}</p>)}
      {
        about.now && (
          <p class="now">
            <span class="now-dot" aria-hidden="true" />
            {about.now}
          </p>
        )
      }
    </div>

    <aside class="fetch" data-reveal data-reveal-delay="120ms" aria-label="Skills and background">
      <div class="fetch-art" aria-hidden="true">
        <Logo size={104} class="fetch-logo" />
      </div>
      <div class="fetch-info">
        <p class="fetch-head">
          <span class="user">jesus</span><span class="at">@</span><span class="host">blazquez</span>
        </p>
        <p class="fetch-rule" aria-hidden="true">{"-".repeat(18)}</p>
        <dl>
          {
            rows.map((r) => (
              <div class="frow">
                <dt>{r.k.padEnd(kw, " ")}</dt>
                <dd>{r.v}</dd>
              </div>
            ))
          }
        </dl>
        <p class="fetch-palette" aria-hidden="true">
          <span style="background:var(--danger)" /><span style="background:var(--warn)" /><span style="background:var(--ok)" /><span style="background:var(--accent-3)" /><span style="background:var(--accent-2)" /><span style="background:var(--accent)" />
        </p>
      </div>
    </aside>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
  }
  .about-text .para {
    color: var(--fg-2);
    margin-top: 1rem;
    font-size: 1.05rem;
    max-width: 42rem;
  }
  .now {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    margin-top: 1.5rem;
    padding: 0.9rem 1.1rem;
    border: 1px solid var(--border);
    border-left: 3px solid var(--ok);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--ok) 7%, transparent);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    color: var(--fg);
  }
  .now-dot {
    flex: none;
    width: 9px;
    height: 9px;
    margin-top: 0.35rem;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 60%, transparent);
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in srgb, var(--ok) 55%, transparent); }
    70% { box-shadow: 0 0 0 8px transparent; }
    100% { box-shadow: 0 0 0 0 transparent; }
  }
  @media (prefers-reduced-motion: reduce) {
    .now-dot { animation: none; }
  }

  /* neofetch-style panel: logo banner on top, info wraps underneath */
  .fetch {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    padding: 1.5rem 1.5rem 1.35rem;
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--bg-2) 55%, transparent);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    overflow-x: auto;
  }
  .fetch-art {
    flex: none;
    align-self: center;
    color: var(--accent);
  }
  .fetch-art :global(.fetch-logo) {
    filter: drop-shadow(0 0 18px var(--accent-glow));
  }
  .fetch-info { min-width: 0; }
  .fetch-head { font-size: 0.9rem; }
  .fetch-head .user { color: var(--accent-2); font-weight: 700; }
  .fetch-head .at { color: var(--fg-dim); }
  .fetch-head .host { color: var(--accent); font-weight: 700; }
  .fetch-rule { color: var(--fg-dim); margin: 0.1rem 0 0.5rem; letter-spacing: 0.1em; }
  .fetch dl { margin: 0; display: grid; gap: 0.28rem; }
  .frow { display: flex; gap: 0.75rem; }
  .frow dt {
    color: var(--accent);
    white-space: pre;
    flex: none;
    text-transform: none;
  }
  .frow dd { color: var(--fg-2); margin: 0; }
  .fetch-palette { display: flex; gap: 4px; margin-top: 0.8rem; }
  .fetch-palette span {
    width: 16px;
    height: 10px;
    border-radius: 2px;
    display: inline-block;
  }

  @media (min-width: 640px) {
    .fetch { font-size: 0.86rem; }
  }
  @media (min-width: 900px) {
    .about-grid { grid-template-columns: 1.35fr 1fr; align-items: start; }
    .fetch { position: sticky; top: 6rem; }
  }
</style>
