---
// /projects/ and /es/projects/: every project, as an `ls -l`-style listing
// with each entry's description and links visible.
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icon from "@/components/Icon.astro";
import ProjectLinks from "@/components/ProjectLinks.astro";
import { getProjectsWithLinks } from "@/lib/related";
import { getLang, localePath } from "@/i18n";
import { getUI } from "@/i18n/ui";

const lang = getLang(Astro.currentLocale);
const t = getUI(lang);
const projects = await getProjectsWithLinks(lang);
---
<BaseLayout title={`${t.projects.allTitle} | Jesús Blázquez`} description={t.projects.allLede}>
  <section class="section">
    <div class="container">
      <a href={localePath(lang, "/")} class="back-link">
        <Icon name="arrow" size={16} class="flip" />
        {t.projects.backHome}
      </a>
      <p class="eyebrow">{t.projects.eyebrow}</p>
      <h1 class="section-title">{t.projects.allTitle}</h1>
      <p class="lede">{t.projects.allLede}</p>

      <div class="terminal">
        <div class="term-bar" aria-hidden="true">
          <span class="dots"><i></i><i></i><i></i></span>
          <span class="term-title">jesus@blazquez: ~/projects</span>
        </div>
        <div class="term-body">
          <p class="term-cmd" aria-hidden="true"><span class="prompt">$</span> ls -l ~/projects</p>
          <ul class="term-list">
            {
              projects.map((p) => (
                <li class="entry" id={p.id}>
                  <div class="entry-head">
                    <span class="perm" aria-hidden="true">drwxr-xr-x</span>
                    <h2 class="pname">
                      {p.title}
                      {p.featured && (
                        <span class="star" title={t.projects.featured}>
                          <span aria-hidden="true">*</span>
                          <span class="sr-only">({t.projects.featured})</span>
                        </span>
                      )}
                    </h2>
                    {p.status && <span class="pstatus">{p.status}</span>}
                  </div>
                  <div class="out">
                    <p class="pdesc">
                      {p.blurb}
                      {p.longDescription && <> {p.longDescription}</>}
                    </p>
                    <p class="pstack">{p.badges.join(" · ")}</p>
                    <ProjectLinks project={p} />
                  </div>
                </li>
              ))
            }
          </ul>
          <p class="term-cmd tail" aria-hidden="true">
            <span class="prompt">$</span> <span class="caret"></span>
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--fg-2);
    margin-bottom: 1rem;
  }
  .back-link:hover { color: var(--accent); }
  .back-link :global(.flip) { transform: rotate(180deg); }
  .lede { color: var(--fg-2); margin-top: 0.6rem; max-width: 42rem; font-size: 1.05rem; }

  .terminal {
    margin-top: 2.25rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    overflow: hidden;
    background: color-mix(in srgb, var(--bg-2) 82%, var(--bg));
    box-shadow: var(--shadow);
    font-family: var(--font-mono);
  }
  .term-bar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem 0.9rem;
    background: color-mix(in srgb, var(--bg-3) 60%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .dots { display: inline-flex; gap: 0.4rem; }
  .dots i {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    opacity: 0.55;
  }
  .dots i:nth-child(1) { background: var(--danger); }
  .dots i:nth-child(2) { background: var(--warn); }
  .dots i:nth-child(3) { background: var(--ok); }
  .term-title { font-size: 0.8rem; color: var(--fg-2); }
  .term-body { padding: 1rem 1.1rem 1.25rem; font-size: 0.9rem; line-height: 1.6; }
  .term-cmd { color: var(--fg-2); }
  .term-cmd .prompt { color: var(--ok); margin-right: 0.5rem; }

  .term-list { list-style: none; padding: 0; margin: 0.75rem 0 0; display: grid; gap: 0.35rem; }
  .entry {
    padding: 0.7rem 0.6rem 0.9rem;
    border-radius: var(--radius-sm);
    scroll-margin-top: 6rem;
  }
  .entry:hover,
  .entry:target { background: color-mix(in srgb, var(--accent) 7%, transparent); }
  .entry + .entry { border-top: 1px dashed var(--border); }
  .entry-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.9rem;
  }
  .perm { color: var(--fg-dim); flex: none; }
  .pname {
    font-family: var(--font-mono);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0;
    color: var(--accent-2);
  }
  .star { color: var(--warn); margin-left: 0.25rem; }
  .pstatus {
    font-size: 0.75rem;
    color: var(--ok);
    border: 1px solid color-mix(in srgb, var(--ok) 45%, transparent);
    border-radius: 999px;
    padding: 0 0.5rem;
  }
  .out { padding-left: calc(10ch + 0.9rem); margin-top: 0.35rem; display: grid; gap: 0.5rem; }
  .pdesc { font-family: var(--font-body); color: var(--fg); max-width: 48rem; }
  .pstack { color: var(--accent-3); font-size: 0.82rem; }

  .term-cmd.tail { margin-top: 0.75rem; }
  .caret {
    display: inline-block;
    width: 9px;
    height: 1.05em;
    vertical-align: text-bottom;
    background: var(--accent);
    animation: term-blink 1.1s steps(2) 4;
  }
  @keyframes term-blink {
    0%, 50% { opacity: 1; }
    50.01%, 100% { opacity: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .caret { animation: none; }
  }

  @media (max-width: 640px) {
    .perm { display: none; }
    .out { padding-left: 0; }
  }
</style>
