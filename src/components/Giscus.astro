---
// Giscus comments. Same repo/category IDs and mapping=pathname as the old
// Hugo site, so preserved /blogs/<slug>/ URLs keep their existing threads.
// The theme follows the site's light/dark state and re-syncs on toggle.
---
<section class="giscus-wrap" aria-label="Comments">
  <script
    src="https://giscus.app/client.js"
    data-repo="jesuscbm/jesuscbm.github.io"
    data-repo-id="R_kgDOO7_8kg"
    data-category="Comments"
    data-category-id="DIC_kwDOO7_8ks4DFxAH"
    data-mapping="pathname"
    data-strict="0"
    data-reactions-enabled="1"
    data-emit-metadata="0"
    data-input-position="bottom"
    data-theme="transparent_dark"
    data-lang="en"
    data-loading="lazy"
    crossorigin="anonymous"
    async></script>
</section>

<script is:inline>
  // Keep Giscus theme in sync with the site theme.
  (function () {
    function giscusTheme() {
      return document.documentElement.getAttribute("data-theme") === "light"
        ? "light"
        : "transparent_dark";
    }
    function send(theme) {
      const frame = document.querySelector("iframe.giscus-frame");
      if (!frame) return;
      frame.contentWindow.postMessage(
        { giscus: { setConfig: { theme } } },
        "https://giscus.app",
      );
    }
    // when the toggle flips, observe the attribute
    const obs = new MutationObserver(() => send(giscusTheme()));
    obs.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ["data-theme"],
    });
  })();
</script>

<style>
  .giscus-wrap {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }
</style>
